{
  "$schema": "http://json.schemastore.org/template",
  "author": "Matthieu QUANTIN",
  "identity": "ReSpAwN.BlazorProjectLarge.Template",
  "name": "Blazor project large (multi-project)",
  "description": "Creates a modular Blazor building block with multiple projects, renaming 'ProjectName' and regenerating project GUIDs.",
  "shortName": "r-bzr-project-l",
  "sourceName": "ProjectName",
  "defaultName": "MyProject",
  "preferNameDirectory": true,

  "classifications": [
    "Blazor",
    ".NET 9",
    "Modular",
    "Application",
    "Web",
    "Clean Architecture",
    "DDD",
    "Starter",
    "Boilerplate"
  ],
  "tags": {
    "language": "C#",
    "type": "project"
  },

  "symbols": {
    "ApplicationKebabCase": {
      "type": "derived",
      "valueSource": "name",
      "replaces": "application-name",
      "valueTransform": "Kebab"
    },

    "ApplicationSnakeCase": {
      "type": "derived",
      "valueSource": "ApplicationKebabCase",
      "replaces": "application_name",
      "valueTransform": "Snake"
    }
  },

  "forms": {
    "Kebab": {
      "identifier": "kebabCase"
    },

    "Snake": {
      "identifier": "replace",
      "source": "Kebab",
      "pattern": "-",
      "replacement": "_"
    }
  },

  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            "**/[Bb]in/**",
            "**/[Oo]bj/**",
            "**/.git/**",
            "**/.vs/**",
            ".template.config/**",
            "BlazorProject.sln",
            "BlazorProject.slnx"
          ]
        }
      ]
    }
  ],

  "guids": [
    "0c125a89-adbe-4b11-b86b-5d4f72ec1e18",
    "00e63df9-2652-4bbd-8a88-6b5479ae3793",
    "da4bde18-275d-4edf-8e19-d3e73f9ff4f6",
    "6f53ff7d-25ca-4257-bd30-11e23a5ccbb0",
    "893cf235-76e0-478a-8770-3cf389c6541b",
    "20aa359c-f73c-48bf-9058-0709f8f60524",
    "19cd247d-993f-4dcd-bed0-73d90aaab727",
    "5671ad3d-190f-4c6d-87ac-c21448f812a4",
    "2cb6ef8f-0c65-4b80-a414-4b6129bb9e2c"
  ],

  "primaryOutputs": [
    { "path": "ProjectName.Application.Contracts/ProjectName.Application.Contracts.csproj" },
    { "path": "ProjectName.Application/ProjectName.Application.csproj" },
    { "path": "ProjectName.Design/ProjectName.Design.csproj" },
    { "path": "ProjectName.Domain.Contracts/ProjectName.Domain.Contracts.csproj" },
    { "path": "ProjectName.Domain/ProjectName.Domain.csproj" },
    { "path": "ProjectName.Infrastructure/ProjectName.Infrastructure.csproj" },
    { "path": "ProjectName.Presentation/ProjectName.Presentation.csproj" },
    { "path": "ProjectName.SharedKernel/ProjectName.SharedKernel.csproj" },
    { "path": "ProjectName.Tests/ProjectName.Tests.csproj" }
  ]
}
