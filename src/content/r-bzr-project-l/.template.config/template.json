{
  "$schema": "http://json.schemastore.org/template",
  "author": "Matthieu QUANTIN",
  "identity": "ReSpAwN.BlazorProjectLarge.Template",
  "name": "Blazor project large (multi-project)",
  "description": "Creates a modular Blazor building block with multiple projects, renaming 'ApplicationName' and regenerating project GUIDs.",
  "shortName": "r-bzr-project-l",
  "sourceName": "ApplicationName",
  "defaultName": "MyProject",
  "preferNameDirectory": true,

  "classifications": [
    "Blazor",
    ".NET 9",
    "Modular",
    "Application",
    "Web",
    "Clean Architecture",
    "DDD",
    "Starter",
    "Boilerplate"
  ],
  "tags": {
    "language": "C#",
    "type": "project"
  },

  "symbols": {
    "ApplicationKebabCase": {
      "type": "derived",
      "valueSource": "name",
      "replaces": "application-name",
      "valueTransform": "Kebab"
    },

    "ApplicationSnakeCase": {
      "type": "derived",
      "valueSource": "ApplicationKebabCase",
      "replaces": "application_name",
      "valueTransform": "Snake"
    }
  },

  "forms": {
    "Kebab": {
      "identifier": "kebabCase"
    },

    "Snake": {
      "identifier": "replace",
      "source": "Kebab",
      "pattern": "-",
      "replacement": "_"
    }
  },

  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            "**/[Bb]in/**",
            "**/[Oo]bj/**",
            "**/.git/**",
            "**/.vs/**",
            ".template.config/**",
            "BlazorProject.sln"
          ]
        }
      ]
    }
  ],

  "guids": [
    "9C014E55-1011-D534-F85F-15181D467A81",
    "48339BAE-2665-4781-A2C1-AD51509E597B",
    "641B9C5B-2DF1-461C-AB08-1D501BA833F5",
    "7C91EF40-5F1C-4BEF-B9DD-85B8212E83CF",
    "1DB68B0C-7756-4C06-94BA-624B1576B73F",
    "9EA4FB7E-E64C-4913-8313-25D0BD7143E2",
    "522DEA4F-0B82-4DC0-AF4D-C3258AA7B6DB"
  ],

  "primaryOutputs": [
    { "path": "../commons/ApplicationName.SharedKernel/ApplicationName.SharedKernel.csproj" },
    { "path": "ApplicationName.Application/ApplicationName.Application.csproj" },
    { "path": "ApplicationName.Domain/ApplicationName.Domain.csproj" },
    { "path": "ApplicationName.Domain.Contracts/ApplicationName.Domain.Contracts.csproj" },
    { "path": "ApplicationName.Infrastructure/ApplicationName.Infrastructure.csproj" },
    { "path": "ApplicationName.Presentation/ApplicationName.Presentation.csproj" },
    { "path": "ApplicationName.Tests/ApplicationName.Tests.csproj" }
  ]
}
